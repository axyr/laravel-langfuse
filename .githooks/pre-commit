#!/usr/bin/env bash
set -e

echo "Running pre-commit checks..."

echo ""
echo "==> Pint (code style)"
vendor/bin/pint --test

echo ""
echo "==> PHPStan (static analysis)"
vendor/bin/phpstan analyse

echo ""
echo "==> PHPMD (complexity)"
# Suppress PHP 8.4 E_DEPRECATED notices emitted by the phpmd/pdepend vendor code
# (implicit-nullable params). Real violations still set a non-zero exit code.
php -d error_reporting='E_ALL & ~E_DEPRECATED' vendor/bin/phpmd src text phpmd.xml

echo ""
echo "==> Pest (tests)"
vendor/bin/pest

echo ""
echo "All checks passed."
